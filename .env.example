APP_URL=http://localhost:3000
TZ=America/New_York

DATABASE_URL=mysql://root@127.0.0.1:3306/ledford_bills_nuxt
# Old Laravel database, read only, used by `npm run migrate:legacy`
LEGACY_DATABASE_URL=mysql://root@127.0.0.1:3306/ledford_bills_flux

# At least 32 characters. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# Local default is Mailpit (`brew services start mailpit`, inbox at http://localhost:8025).
# Production: smtp://user:pass@host:587 . Set MAIL_TRANSPORT=log to print mail to the console instead.
MAIL_URL=smtp://127.0.0.1:1025
MAIL_FROM="Ledford Bills <bills@example.com>"
MAIL_TRANSPORT=
